# ==============================================================================
# .gitignore — Conductor (Smart Zigbee Console for Logitech Z906)
# ==============================================================================

# ─── 1. Personal, Private & Developer-Specific Files ─────────────────────────
# Files and notes meant only for the local developer or personal tracking.
TODO.md
todo.md
TODO
TODO.txt
*.todo
todos/
NOTES.md
notes.md
NOTE.md
note.md
scratchpad.md
*.draft.md
*.personal.md
*.private.md
my_*.md
personal/
private/

# Local environment, secrets, credentials, and configuration overrides
.env
.env.*
*.env
*.local
*.local.*
secrets.*
local_settings.*

# Scratch spaces and temporary working directories
/.temporary/
/logs/
/scratch/
scratch.*
temp/
tmp/

# ─── 2. PlatformIO & ESP-IDF Build Artifacts ─────────────────────────────────
# Build outputs, libraries, and compiler caches
.pio/
build/
.espressif/
managed_components/

# Binary, object, and firmware outputs
*.bin
*.elf
*.hex
*.map
*.o
*.obj
*.d
*.a
*.lib

# Packaging and distribution artifacts
dist/*.ota
out/

# ESP-IDF sdkconfig management
# Generated by menuconfig — never commit the bare sdkconfig file directly.
# Explicit exceptions: sdkconfig.defaults and environment-specific files are tracked.
sdkconfig
sdkconfig.old
sdkconfig.ci
!sdkconfig.defaults
!sdkconfig.*

# ─── 3. Log Files & Core Dumps ───────────────────────────────────────────────
# All logs should be written to logs/ or excluded.
*.log
*.dump
*.dmp
/core
/core.*
core.[0-9]*

# ─── 4. Python & Virtual Environments ────────────────────────────────────────
# Python environments, bytecode, and test caches (used by tooling in tools/)
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ─── 5. Node.js & JavaScript Tooling ─────────────────────────────────────────
# JavaScript dependencies and runtimes (used by tools/ and converter tests)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/

# ─── 6. IDEs & Code Editors ──────────────────────────────────────────────────
# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/mcp.json

# JetBrains / CLion / IntelliJ
.idea/
*.iml
*.iws

# Eclipse / CDT
.project
.cproject
.settings/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs / Nano
*.swp
*.swo
.*.sw[a-p]
*~
\#*\#
.#*

# ─── 7. Operating System Noise ───────────────────────────────────────────────
# Microsoft Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
.directory
.fuse_hidden*
